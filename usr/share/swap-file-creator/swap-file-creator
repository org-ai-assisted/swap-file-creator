source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/live-mode.sh

log() {
  if [ "${VERBOSE-}" = "true" ]; then
    printf '%s\n' "$*" || true
    return 0
  fi
  printf '%s\n' "$0: $*" | systemd-cat || true
  return 0
}

error_handler() {
  local exit_code="$?"
  trap "" ERR
  log "\
###############################################################################
## Swap File Creator ERROR
## $0
##
## BASH_COMMAND: '${BASH_COMMAND}'
## exit_code: '${exit_code}'
##
## For debugging, please run:
##     bash -x $0 start
## and/or:
##     bash -x $0 stop
##
## Clean the output and submit to developers.
##
## See also:
## This does not indicate a system compromise. The system can run without a swap file.
## https://www.kicksecure.com/wiki/swap-file-creator
###############################################################################\
" >&2
  exit 1
}

exit_handler() {
  local exit_code="$?"
  if [ "${exit_code}" = "0" ]; then
    log "INFO: END: OK"
  else
    log "ERROR: END: with ERROR exit code: '${exit_code}'" >&2
  fi
  exit "${exit_code}"
}

sanity_tests() {
  local cmd_list cmd

  #cryptsetup
  #mkdir
  #/usr/lib/systemd/systemd-cryptsetup
  cmd_list=(
    'safe-rm'
    'chown'
    'mkswap'
    'swapon'
    'swapoff'
    'cat'
    'test'
    'printf'
    'stat'
    'mountpoint'
    'grep'
    'sed'
    'blkid'
    'findmnt'
    'fallocate'
    'df'
    'free'
    'bc'
    'calculate-swap-size'
  )

  for cmd in "${cmd_list[@]}"; do
    has "${cmd}"
  done
}

source_config_files() {
  shopt -s nullglob
  local i

  for i in /etc/default/swap-file-creator /etc/default/swap-file-creator.d/*.conf /usr/local/etc/default/swap-file-creator.d/*.conf; do
    if ! test -f "${i}"; then
      continue
    fi
    bash -n "${i}"
    source "${i}"
  done
}

set_defaults() {
  [[ -v "DESC" ]] || DESC="Swap File Creator"
  [[ -v "NAME" ]] || NAME="swap-file-creator"
  [[ -v "SWAPFILE" ]] || SWAPFILE="/var/swapfile"
  [[ -v "VERBOSE" ]] || VERBOSE="false"
  ## TODO: Can this be autogenerated?
  [[ -v "UUID" ]] || UUID="0615ba72-85b0-4183-8d54-300bb0d2e491"
  [[ -v "RUN_FOLDER" ]] || RUN_FOLDER="/run/${NAME}"
  ## https://gitlab.com/cryptsetup/cryptsetup/-/issues/617
  ## Neither cryptsetup nor hardened-malloc is still used here.
  #[[ -v "cryptsetup_pre_wrapper" ]] || cryptsetup_pre_wrapper="ld-system-preload-disable"
  [[ -v "SWAPON_EXTRA" ]] || SWAPON_EXTRA=""
  [[ -v "MKSWAP_EXTRA" ]] || MKSWAP_EXTRA=""
  [[ -v "RANDOM_DEVICE" ]] || RANDOM_DEVICE="/dev/random"
  [[ -v "ENOUGH_RAM" ]] || ENOUGH_RAM="1950"
  [[ -v "SWAPFILE_SIZE_CUSTOM_MB" ]] || SWAPFILE_SIZE_CUSTOM_MB=""
  [[ -v "DO_PRE_CHECK" ]] || DO_PRE_CHECK="true"
}

should_make_swapfile() {
  local do_pre_check="$1" virt="$2" luks_ok="$3"

  if [ "${do_pre_check}" = 'false' ]; then
    printf '%s\n' 'proceed'
    return 0
  fi
  if [ "${virt}" = 'xen' ]; then
    printf '%s\n' 'skip-xen'
    return 0
  fi
  if [ "${luks_ok}" != 'true' ]; then
    printf '%s\n' 'skip-no-luks'
    return 0
  fi
  printf '%s\n' 'proceed'
  return 0
}

swap_size_field_to_gb() {
  local field gb
  field="$1"
  if [[ "${field}" == *G ]]; then
    gb="${field%G}"
  elif [[ "${field}" == *M ]]; then
    gb="$(bc <<< "scale=2; ${field%M} / 1024")"
  else
    return 1
  fi
  printf '%.0f\n' "${gb}"
  return 0
}

swapon_last_record_matching() {
  local line found=''
  while IFS= read -r line; do
    case "${line}" in
      ## "${line}" may contain backslash hexadecimal backslash escapes for
      ## special characters. Unfortunately, the backslash itself is not one of
      ## the characters that is escaped, so we can't use printf's %b mechanism
      ## to convert the first field properly. Using verbatim matching for now.
      "$2 "* | "$2")
        found="${line}"
        ;;
    esac
  done <<< "$1"
  printf '%s\n' "${found}"
}

do_stop() {
  local swapon_output swapoff_exitcode swapon_listing_ok swap_is_active
  if ! [[ "${SWAPFILE}" = /* ]]; then
    log "ERROR: 'SWAPFILE' value '${SWAPFILE}' is not an absolute path. Refusing to operate." >&2
    return 1
  fi
  swapoff_exitcode='0'
  swapon_listing_ok='true'
  swap_is_active='true'
  swapon_output="$(swapon 2>/dev/null)" || swapon_listing_ok='false'
  if [ -f "${SWAPFILE}" ]; then
    if [ "${swapon_listing_ok}" = 'true' ] \
      && [ -z "$(swapon_last_record_matching "${swapon_output}" "${SWAPFILE}")" ]; then
      swap_is_active='false'
    fi

    if [ "${swap_is_active}" = 'true' ]; then
      swapoff "${SWAPFILE}" || { swapoff_exitcode="$?"; true; };
    fi
  fi

  if [ "${swapoff_exitcode}" != '0' ]; then
    return 1
  fi

  if ! [ -f "${SWAPFILE}" ]; then
    return 0
  fi

  if ! safe-rm --force -- "${SWAPFILE}"; then
    log "ERROR: Failed to remove swap file '${SWAPFILE}'." >&2
    return 1
  fi

  ## safe-rm might not have removed the file.
  if [ -e "${SWAPFILE}" ]; then
    log "ERROR: Swap file '${SWAPFILE}' still present after safe-rm (protected path?)." >&2
    return 1
  fi

  return 0
}

do_start() {
  local systemd_detect_virt_output hibernation_consideration filesystem_type

  log "INFO: swap-file-creator..."

  total_ram_in_mb="$(free -m | sed  -n -e '/^Mem:/s/^[^0-9]*\([0-9]*\) .*/\1/p')"

  if [ "${total_ram_in_mb}" -ge "${ENOUGH_RAM}" ]; then
    log "INFO: Enough RAM available (at least ${ENOUGH_RAM} MB). OK."
  else
    if [ "${VERBOSE-}" = "false" ]; then
      VERBOSE=true
      log "INFO: swap-file-creator..."
    fi
    log "INFO: Low RAM detected (less than ${ENOUGH_RAM} MB)."
    log "INFO: Consider assigning 2048 MB (2 GB) or more RAM to this machine."
    log "INFO: See: https://www.kicksecure.com/wiki/swap-file-creator"
  fi

  if ! [[ "${SWAPFILE}" = /* ]]; then
    log "ERROR: 'SWAPFILE' value '${SWAPFILE}' is not an absolute path. Swap file not enabled." >&2
    exit 1
  fi

  ## Script intentionally assumes that SWAPFILE will point to a root-owned
  ## location, and that if it is a symlink, the entire symlink chain points to
  ## root-owned locations.

  systemd_detect_virt_output=""
  if has systemd-detect-virt ; then
    if systemd_detect_virt_output="$(systemd-detect-virt 2>/dev/null)" ; then
      ## Exit code 0. Virtualization detected.
      ## Therefore disabling hibernation consideration.
      hibernation_consideration=false
    else
      ## https://forums.kicksecure.com/t/enable-and-use-zram-instead-for-swap/654/8
      #hibernation_consideration=true
      hibernation_consideration=false
    fi
  else
    ## XXX
    hibernation_consideration=false
    systemd_detect_virt_output=""
  fi

  local luks_ok should_make_swapfile_status
  luks_ok='false'
  if [ "${DO_PRE_CHECK}" = 'true' ] && [ "${systemd_detect_virt_output}" != 'xen' ]; then
    if luks-path-check "${SWAPFILE}" &>/dev/null ; then
      luks_ok='true'
    fi
  fi

  should_make_swapfile_status="$(should_make_swapfile "${DO_PRE_CHECK}" "${systemd_detect_virt_output}" "${luks_ok}")"
  case "${should_make_swapfile_status}" in
    skip-xen)
      log "INFO: Virtualizer 'xen' detected. Could be 'Qubes'. Skipping swap-file-creator (no swap file will be created). Doing nothing, OK."
      exit 0
      ;;
    skip-no-luks)
      log "INFO: Encrypted disk (LUKS) detected for file '${SWAPFILE}': no. Not creating a swap file (expected). Doing nothing, OK. See also: https://www.kicksecure.com/wiki/swap-file-creator"
      exit 0
      ;;
    proceed)
      ;;
    *)
      log "ERROR: Value of should_make_swapfile_status ('${should_make_swapfile_status}') is not recognized. Swap file not enabled." >&2
      exit 1
      ;;
  esac

  ## User can set HIBERNATION=true in /etc/default/swap-file-creator
  [[ -v "HIBERNATION" ]] || HIBERNATION="${hibernation_consideration}"

  local swapfile_actual_size_in_bytes
  if [ -f "${SWAPFILE}" ]; then
    ## Sanity test.
    test -r "${SWAPFILE}"

    ## We want the logical size of the swapfile, not the physical size.
    swapfile_actual_size_in_bytes="$(stat --format='%s' -- "${SWAPFILE}")"
    is_whole_number_int64 "${swapfile_actual_size_in_bytes}" || exit 1
  else
    swapfile_actual_size_in_bytes="0"
  fi

  local folder_of_swapfile
  folder_of_swapfile="${SWAPFILE%/*}"
  folder_of_swapfile="${folder_of_swapfile:-/}"

  if ! test -d "${folder_of_swapfile}" ; then
    log "ERROR: folder_of_swapfile '${folder_of_swapfile}' does not exist." >&2
    exit 1
  fi

  if ! test -w "${folder_of_swapfile}" ; then
    log "INFO: File ${SWAPFILE} (actually folder ${folder_of_swapfile}) is not writeable. Maybe read-only file system? Exiting."
    exit 0
  fi

  local total_disk_space_in_mb
  total_disk_space_in_mb="$(df -P -k "${folder_of_swapfile}" | awk 'NR==2 {print int($2/1024)}')"

  local swapfile_target_size_mb
  if [ "${SWAPFILE_SIZE_CUSTOM_MB}" = "" ]; then
    local calculate_swap_size_report
    calculate_swap_size_report="$(calculate-swap-size "${total_ram_in_mb}" "${total_disk_space_in_mb}" "${HIBERNATION}")"

    ## For informational output.
    log "${calculate_swap_size_report}"

    ## Take last word of last line.
    swapfile_target_size_mb="$(tail -1 <<< "${calculate_swap_size_report}")"
    swapfile_target_size_mb="$(awk '{print $NF}' <<< "${swapfile_target_size_mb}")"
  else
    swapfile_target_size_mb="${SWAPFILE_SIZE_CUSTOM_MB}"
  fi

  if ! is_whole_number_int64 "${swapfile_target_size_mb}"; then
    log "ERROR: swap size '${swapfile_target_size_mb}' MB is not a non-negative integer. Swap file not enabled." >&2
    exit 1
  fi
  if [ "${swapfile_target_size_mb}" -lt '1' ] \
    || [ "${swapfile_target_size_mb}" -gt '1048576' ]; then
    log "ERROR: swap size '${swapfile_target_size_mb}' MB is out of range (1..1048576 MiB). Swap file not enabled." >&2
    exit 1
  fi
  if ! [[ "${UUID}" =~ ^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$ ]]; then
    log "ERROR: UUID '${UUID}' is not a valid UUID. Swap file not enabled." >&2
    exit 1
  fi

  local swapfile_target_size_bytes
  swapfile_target_size_bytes="$(( ${swapfile_target_size_mb} * 1048576 ))"

  local swapfile_target_size_gb
  swapfile_target_size_gb="$(bc <<< "scale=2; ${swapfile_target_size_bytes}/1024/1024/1024")"
  ## Round to integer.
  swapfile_target_size_gb="$(printf "%.0f" "${swapfile_target_size_gb}")"

  local free_disk_space_in_bytes effective_free_in_bytes headroom_in_bytes required_in_bytes
  free_disk_space_in_bytes="$(df -P --block-size=1 "${folder_of_swapfile}" | awk 'NR==2 {print $4}')"
  headroom_in_bytes="$(( 2 * 1024 * 1024 * 1024 ))"
  effective_free_in_bytes="$(( free_disk_space_in_bytes + swapfile_actual_size_in_bytes ))"
  required_in_bytes="$(( swapfile_target_size_bytes + headroom_in_bytes ))"

  if [ "${required_in_bytes}" -gt "${effective_free_in_bytes}" ]; then
    log "ERROR: Insufficient free disk space: need ${required_in_bytes} bytes (swap ${swapfile_target_size_gb} GB + 2 GB headroom), have ${effective_free_in_bytes} bytes (${free_disk_space_in_bytes} free + ${swapfile_actual_size_in_bytes} reclaimable). Swap file not enabled." >&2
    exit 1
  fi

  filesystem_type="$(findmnt --noheadings --output FSTYPE --target "${folder_of_swapfile}")"

  if [ "${filesystem_type}" = "btrfs" ]; then
    if ! has btrfs; then
      log "ERROR: btrfs filesystem detected but the 'btrfs' tool is missing. Install btrfs-progs. Swap file not enabled." >&2
      exit 1
    fi
  fi

  if ! do_stop; then
    log "ERROR: Could not deactivate existing swap at '${SWAPFILE}'; refusing to overwrite a possibly-active swap file. Swap file not enabled." >&2
    exit 1
  fi

  if [ "${filesystem_type}" = "btrfs" ]; then
    ## Need to use 'btrfs'. Otherwise, 'swapon "${SWAPFILE}" ${SWAPON_EXTRA}' would fail with:
    ## > swapon: /var/swapfile: swapon failed: Invalid argument
    ## https://unix.stackexchange.com/questions/599949/swapfile-swapon-invalid-argument
    ## https://btrfs.readthedocs.io/en/latest/Swapfile.html
    btrfs filesystem mkswapfile --uuid "${UUID}" --size "${swapfile_target_size_bytes}" "${SWAPFILE}"
  else
    fallocate --length "${swapfile_target_size_bytes}" "${SWAPFILE}"
    # shellcheck disable=SC2086
    mkswap --label "swapfile" --uuid "${UUID}" "${SWAPFILE}" ${MKSWAP_EXTRA} >/dev/null
  fi

  chown root:root -- "${SWAPFILE}"
  chmod 0600 -- "${SWAPFILE}"

  # shellcheck disable=SC2086
  swapon "${SWAPFILE}" ${SWAPON_EXTRA}

  ## /proc/swap does not show the label.
  ## output by swapon_line is not predictable, G vs M as unit.
  local swapon_line
  swapon_line="$(swapon --noheadings --raw --show=NAME,SIZE)" || true
  swapon_line="$(swapon_last_record_matching "${swapon_line}" "${SWAPFILE}")" || true
  ## example swapon_line:
  #swapon_line="/var/swapfile 1024M"
  swapfile_size_with_unit="$(awk '{print $NF}' <<< "${swapon_line}")" || true

  local swapfile_kernel_reported_size_gb
  if ! swapfile_kernel_reported_size_gb="$(swap_size_field_to_gb "${swapfile_size_with_unit}")"; then
    log "\
INFO: Minor note (not an error).
Swap file has been enabled; the size self-check was skipped.
Output of:
    swapon --noheadings --raw --show=NAME,SIZE
reported an unexpected unit for file '${SWAPFILE}' (not M or G).
swapon_line: '${swapon_line}'
swapfile_size_with_unit: '${swapfile_size_with_unit}'"
    return 0
  fi

  local swapfile_kernel_reported_size_gb_plus
  swapfile_kernel_reported_size_gb_plus="$(( ${swapfile_kernel_reported_size_gb} + 1 ))"

  if [ "${swapfile_kernel_reported_size_gb_plus}" -ge "${swapfile_target_size_gb}" ]; then
    log "INFO: File '${SWAPFILE}' (${swapfile_target_size_gb} GB) created and enabled. OK."
    return 0
  fi

  log "ERROR: swapfile_kernel_reported_size_gb_plus is smaller than expected swapfile_target_size_gb!" >&2
  log "swapfile_kernel_reported_size_gb_plus: '${swapfile_kernel_reported_size_gb_plus}'" >&2
  log "swapfile_target_size_gb: '${swapfile_target_size_gb}'" >&2
  ## Too little swap is better than no swap, therefore no rollback.
  exit 1
}

main() {
  set -o errexit
  set -o nounset
  set -o pipefail
  set -o errtrace
  shopt -s inherit_errexit
  shopt -s shift_verbose

  ## https://forums.whonix.org/t/swap-file-creator-error/21128/3
  ## avoid printf error "bash: printf: 3.14: invalid number".
  ## LANG=C does not suffice:
  ## https://unix.stackexchange.com/questions/576701/what-is-the-difference-between-lang-c-and-lc-all-c
  export LC_ALL=C

  if ! [ "$(id -u)" = 0 ]; then
    log "$0: ERROR: Must be run as root/sudo." >&2
    exit 1
  fi

  if [ "${live_status_detected}" = "true" ]; then
    true "INFO: live mode detected. Swap file creation skipped."
    exit 0
  fi

  if [ "$#" -eq 0 ]; then
    log "ERROR: No arguments provided." >&2
    log "Usage: $0 (start|stop)" >&2
    exit 1
  fi

  trap "error_handler" ERR
  trap "exit_handler" EXIT

  ## Don't let a dying reader break swap setup.
  trap '' PIPE

  sanity_tests
  source_config_files
  set_defaults

  case "$1" in
    start)
      do_start
      ;;
    stop)
      do_stop
      ;;
    *)
      log "ERROR: Invalid argument: $1" >&2
      log "Usage: $0 (start|stop)" >&2
      exit 1
      ;;
  esac
}

if was_executed "${BASH_SOURCE[0]}"; then
  main "$@"
fi
